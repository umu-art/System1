{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "System1 scenario definition v1",
  "type": "object",
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "flows": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/flowId"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "trigger": {
            "$ref": "#/$defs/blockId"
          }
        },
        "additionalProperties": false
      },
      "minProperties": 1
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "type": "object",
        "properties": {
          "type": {
            "const": "message_trigger"
          }
        },
        "required": [
          "type"
        ]
      },
      "minContains": 0,
      "maxContains": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/command"
          },
          {
