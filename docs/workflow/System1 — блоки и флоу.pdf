          },
          {
            "$ref": "#/$defs/condition"
          },
          {
            "$ref": "#/$defs/api"
          },
          {
            "$ref": "#/$defs/action"
          },
          {
            "$ref": "#/$defs/set_value"
          }
        ]
      }
    }
  },
  "required": [
    "formatVersion",
    "flows",
    "blocks"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
    },
    "key": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
    },
    "reference": {
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "#/$defs/readPath"
        }
      },
      "required": [
        "ref"
      ],
      "additionalProperties": false
    },
    "argument": {
      "oneOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "$ref": "#/$defs/reference"
        }
      ]
    },
    "condition": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/blockId"
        },
        "type": {
          "const": "condition"
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/predicateCase"
          }
        },
        "default": {
          "$ref": "#/$defs/blockId"
        }
      },
      "required": [
        "id",
        "type",
        "cases",
        "default"
      ],
      "additionalProperties": false
    },
    "api": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/blockId"
        },
        "type": {
          "const": "api"
        },
        "operation": {
          "$ref": "#/$defs/id"
        },
        "args": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/key"
          },
          "additionalProperties": {
            "$ref": "#/$defs/argument"
          }
        },
        "saveAs": {
          "$ref": "#/$defs/key"
        },
        "next": {
          "$ref": "#/$defs/blockId"
        },
        "onError": {
          "$ref": "#/$defs/blockId"
        }
      },
      "required": [
        "id",
        "type",
        "operation",
        "args"
      ],
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/blockId"
        },
        "type": {
          "const": "action"
        },
        "operation": {
          "$ref": "#/$defs/id"
        },
        "args": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/key"
          },
          "additionalProperties": {
            "$ref": "#/$defs/argument"
          }
        },
        "saveAs": {
          "$ref": "#/$defs/key"
        },
        "next": {
          "$ref": "#/$defs/blockId"
        },
        "onError": {
          "$ref": "#/$defs/blockId"
        }
      },
      "required": [
        "id",
        "type",
        "operation",
        "args"
      ],
      "additionalProperties": false
    },
    "readPath": {
      "type": "string",
      "pattern": "^(event\\.text|(input|state)\\.[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)*)$"
    },
    "flowId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
    },
    "blockId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}\\.[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "message_trigger": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/blockId"
        },
        "type": {
          "const": "message_trigger"
        },
        "next": {
          "$ref": "#/$defs/blockId"
        }
      },
      "required": [
        "id",
        "type",
        "next"
      ],
      "additionalProperties": false
    },
    "send_message": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/blockId"
        },
        "type": {
          "const": "send_message"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "media": {
          "$ref": "#/$defs/reference"
        },
        "next": {
          "$ref": "#/$defs/blockId"
        },
        "buttons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/telegramButton"
          }
        }
      },
      "required": [
        "id",
        "type"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "text"
          ]
        },
        {
          "required": [
            "media"
          ]
        }
      ]
    },
    "wait_message": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/blockId"
        },
        "type": {
          "const": "wait_message"
        },
        "saveAs": {
          "$ref": "#/$defs/key"
        },
        "next": {
          "$ref": "#/$defs/blockId"
        },
        "priority": {
          "type": "integer",
          "minimum": 0
        },
        "resetAfterReceive": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "type",
        "saveAs",
        "next",
        "priority",
        "resetAfterReceive"
      ],
      "additionalProperties": false
    },
    "commandName": {
      "type": "string",
      "pattern": "^/[a-z0-9_]{1,32}$"
    },
    "command": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/blockId"
        },
        "type": {
          "const": "command"
        },
        "command": {
          "$ref": "#/$defs/commandName"
        },
        "scope": {
          "enum": [
            "entry",
            "run"
          ]
        },
        "next": {
          "$ref": "#/$defs/blockId"
        }
      },
      "required": [
        "id",
        "type",
        "command",
        "scope",
        "next"
      ],
      "additionalProperties": false
    },
    "telegramButton": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "command": {
              "$ref": "#/$defs/commandName"
            }
          },
          "required": [
            "text",
            "command"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^(https?://|tg://).+"
                },
                {
                  "$ref": "#/$defs/reference"
                }
              ]
            }
          },
          "required": [
            "text",
            "url"
          ],
          "additionalProperties": false
        }
      ]
    },
    "predicateCase": {
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "#/$defs/readPath"
        },
        "transform": {
          "const": "length"
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "predicate": {
          "enum": [
            "eq",
            "lt",
            "gt"
          ]
        },
        "next": {
          "$ref": "#/$defs/blockId"
        }
      },
      "required": [
        "predicate",
        "ref",
        "value",
        "next"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "predicate": {
                "enum": [
                  "lt",
                  "gt"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "transform"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      ]
    },
    "set_value": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/blockId"
        },
        "type": {
          "const": "set_value"
        },
        "ref": {
          "type": "string",
          "pattern": "^(input|state)\\.[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)*$"
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "next": {
